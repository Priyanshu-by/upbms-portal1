# =================================================================
# UPBMS Backend Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# Never commit your actual .env file to Git!
# =================================================================

# Server Port
PORT=5000

# Optional: Public Backend URL for Render Keep-Alive Ping (every 9 min)
# Render automatically provides RENDER_EXTERNAL_URL in production, or set this manually:
KEEP_ALIVE_URL=

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# JWT Secret for Signing Authentication Tokens
JWT_SECRET=your_jwt_secret_key_change_me_in_production

# =================================================================
# Official Email OTP Configuration (Registration & Forgot Password)
# =================================================================
# OPTION A (RECOMMENDED - Works on Render Free Tier & Locally): Resend REST API
# How to get your Resend API Key:
#   1. Go to https://resend.com and sign up / log in (Free: 100 emails/day, 3,000/month).
#   2. In the Resend Dashboard, go to "API Keys" -> click "Create API Key".
#   3. Give it a name (e.g. "UPBMS Portal"), select "Sending access", and copy the key (starts with re_...).
#   4. Paste it below in RESEND_API_KEY (and add it in Render Dashboard -> Environment Variables).
#   5. Note: Without a verified custom domain, Resend's default sender (onboarding@resend.dev)
#      can only send test emails to your own Resend account email. To send to any user email,
#      add & verify your domain in Resend Dashboard -> Domains, then set RESEND_FROM=UPBMS <noreply@yourdomain.com>.
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM=UPBMS <onboarding@resend.dev>

# OPTION B (Alternative HTTPS API): Brevo REST API (300 free emails/day)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=upbmsofficial@gmail.com

# OPTION C: Gmail Nodemailer SMTP (Works locally; Render Free Tier blocks ports 465 & 587)
GMAIL_USER=upbmsofficial@gmail.com
GMAIL_APP_PASSWORD=your_16_char_gmail_app_password

# MongoDB Atlas Connection String
# Paste your MongoDB Atlas URI here when ready:
# Example: mongodb+srv://admin:MyPassword123@cluster0.abcde.mongodb.net/upbms?retryWrites=true&w=majority
MONGODB_URI=

# Centralized Cloudinary Image-Upload Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
MAX_FILE_SIZE=10485760

# Google OAuth 2.0 Client ID (Optional: One-Click Sign In)
GOOGLE_CLIENT_ID=

# Razorpay Payment Gateway Credentials (Required for Online Membership Payments)
# 1. RAZORPAY_KEY_ID: Public Key ID (e.g. rzp_test_xxxxxxxx or rzp_live_xxxxxxxx)
# 2. RAZORPAY_KEY_SECRET: Private Key Secret (Keep confidential on backend!)
# 3. RAZORPAY_WEBHOOK_SECRET: Secret configured in Razorpay Dashboard for Webhook verification
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Punjab National Bank (PNB) Merchant Dynamic QR Gateway Credentials
# 1. PNB_MERCHANT_ID: Authorized PNB Merchant ID (MID)
# 2. PNB_TERMINAL_ID: Terminal ID (TID) or Sub-Merchant ID
# 3. PNB_MERCHANT_VPA: Official Merchant UPI VPA (e.g. upbms@pnb)
# 4. PNB_MERCHANT_NAME: Merchant display name registered with PNB
# 5. PNB_API_KEY: API Client Key provided by PNB IT / Payment Gateway Desk
# 6. PNB_SECRET_KEY: HMAC SHA-256 Secret Key for payload signature & webhook verification
# 7. PNB_BASE_URL: PNB Merchant Gateway Endpoint (Sandbox or Production)
PNB_MERCHANT_ID=
PNB_TERMINAL_ID=
PNB_MERCHANT_VPA=upbms@pnb
PNB_MERCHANT_NAME=Uttar Pradesh Bank Mitra Sangh
PNB_API_KEY=
PNB_SECRET_KEY=
PNB_BASE_URL=https://merchant.pnbindia.in


